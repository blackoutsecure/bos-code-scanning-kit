{
  "gate": {
    "enable_lint": true,
    "enable_python_lint": true,
    "python_version": "3.12",
    "python_packages": [
      "ruff>=0.6",
      "pytest>=8.0",
      "PyYAML>=6.0"
    ],
    "enable_dependency_review": true,
    "enable_code_scan": true,
    "enable_pinned_actions_check": true,
    "enable_pr_title_check": true,
    "enable_readme_header_check": true,
    "readme_header_profile": "marketplace",
    "code_scan_fail_on": "fail"
  },
  "marketplace": {
    "enabled": true,
    "source_branch": "dev",
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      "README.md",
      "LICENSE",
      "NOTICE",
      "src/**",
      "test/**",
      "scripts/**",
      "pyproject.toml"
    ],
    "blocked_paths": [
      ".github/workflows/"
    ],
    "required_paths": [
      "action.yml",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "managed_file_sync": {
    "direction": "source-to-destination",
    "services": [
      "common",
      "lf_line_endings",
      "dependabot_actions",
      "dotfiles",
      "markdownlint",
      "shellcheck"
    ]
  },
  "action_test": {
    "python_versions": [
      "3.10",
      "3.11",
      "3.12"
    ],
    "os_matrix": [
      "ubuntu-latest"
    ],
    "python_packages": [
      "pytest>=8.0",
      "ruff>=0.6",
      "PyYAML>=6.0"
    ],
    "pytest_args": "-q",
    "enable_smoke_test": false,
    "timeout_pytest": 10,
    "timeout_smoke": 5
  }
}
