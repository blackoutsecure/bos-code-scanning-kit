{
  "target_repo_role": "consumer",
  "security": {
    "enable_lint": true,
    "enable_python_lint": true,
    "python_version": "3.12",
    "python_packages": [
      "ruff>=0.6",
      "pytest>=8.0",
      "PyYAML>=6.0"
    ],
    "enable_dependency_review": true,
    "enable_code_scan": true,
    "enable_pinned_actions_check": true,
    "enable_pr_title_check": true,
    "enable_readme_header_check": true,
    "readme_header_profile": "marketplace",
    "code_scan_fail_on": "fail"
  },
  "marketplace": {
    "enabled": true,
    "source_branch": "dev",
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      "README.md",
      "LICENSE",
      "NOTICE",
      "src/**",
      "test/**",
      "scripts/**",
      "pyproject.toml"
    ],
    "blocked_paths": [
      ".github/workflows/"
    ],
    "required_paths": [
      "action.yml",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "sync": {
    "services": [
      "common",
      "lf_line_endings",
      "dependabot_actions",
      "dependabot_pip",
      "python",
      "markdownlint",
      "shellcheckrc",
      "bos_universal_config"
    ]
  }
}
